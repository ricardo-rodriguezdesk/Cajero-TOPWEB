# Copia este archivo como .env (en Windows: copy .env.example .env)

# Puerto local
PORT=3000

# ---------------- Base de datos PROPIA del cajero ----------------
# PostgreSQL del cajero (recomendado: un proyecto de Supabase SOLO para el cajero).
# Supabase → Connect → "Transaction pooler" (puerto 6543). Reemplaza [YOUR-PASSWORD].
DATABASE_URL=postgresql://postgres.xxxxxxxx:[YOUR-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres
# Supabase usa SSL. Solo pon false si usas un PostgreSQL local sin SSL.
DB_SSL=true

# Secreto para cifrar la API Key en la base de datos y firmar la sesión del panel.
# Mínimo 16 caracteres. Si lo cambias, tendrás que volver a capturar la API Key.
ATM_SECRET=cambia-este-secreto-por-uno-largo

# ---------------- Banco Central ----------------
# true = usa el simulador del Banco Central (API Key: atm_demo_key)
# false = usa la API real de la Persona 1
USE_MOCK=true

# URL inicial de la API del Banco Central (también se puede capturar en el panel admin)
CENTRAL_API_URL=http://localhost:8000

# Tiempo máximo de espera al Banco Central por intento, en milisegundos
CENTRAL_TIMEOUT_MS=6000
# Reintentos si el Central no responde (con la MISMA Idempotency-Key: no cobra dos veces)
CENTRAL_REINTENTOS=2

# ---------------- Panel administrativo ----------------
ADMIN_PASSWORD=cambia-esta-contrasena

# ---------------- Reglas locales del cajero ----------------
ATM_MULTIPLO=50
ATM_MAX_RETIRO=10000
ATM_MAX_DEPOSITO=20000
ATM_ZONA_HORARIA=America/Mexico_City
